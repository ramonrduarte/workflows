      "id": "8bb72b06-1ca3-43b7-86ba-68b32be6a8cb",
      "name": "Webhook Supabase",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1200,
        128
      ],
      "webhookId": "tray-supabase-status"
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst bodyArray = payload.body;\n\nif (!bodyArray || !Array.isArray(bodyArray) || bodyArray.length === 0) {\n  throw new Error('Payload inválido: body ausente ou vazio');\n}\n\nconst results = [];\n\nfor (const item of bodyArray) {\n  const msgBody = item?.message?.body;\n  if (!msgBody) continue;\n\n  // Só processa escopo de pedido\n  if (msgBody.scope_name !== 'order') continue;\n\n  results.push({\n    msg_id: item.msg_id,\n    numero_pedido: msgBody.scope_id,\n    acao: msgBody.act,\n    escopo: msgBody.scope_name,\n    seller_id: msgBody.seller_id\n  });\n}\n\nif (results.length === 0) {\n  throw new Error('Nenhum item de pedido encontrado no payload');\n}\n\nreturn results;"
      },
      "id": "89d69db1-d896-4b3c-bc22-8b872342cadb",
      "name": "Parser - Extrai Campos Tray",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
