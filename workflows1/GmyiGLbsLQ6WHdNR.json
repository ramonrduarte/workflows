      "id": "01254e3a-605c-4fe0-b045-17b5ab68b566",
      "name": "HTTP - Buscar Pedido Tray",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -720,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const orderData = $input.first().json;\nconst pedidoInfo = $('Parser - Extrai Campos Tray').item.json;\n\n// Tray retorna o pedido dentro de Order[]\nconst order = orderData.Order?.[0]?.Order || orderData.Order || orderData;\n\nif (!order) {\n  throw new Error(`Pedido #${pedidoInfo.numero_pedido}: resposta inválida da Tray`);\n}\n\nconst status = parseInt(order.status_id || order.status || 0);\nconst customer = order.Customer || {};\nconst firstName = (customer.name || 'Cliente').split(' ')[0];\nconst orderId = order.id || order.number || pedidoInfo.numero_pedido;\n\n// Formata telefone para WhatsApp (formato: 55DDNUMERO)\nlet phone = (customer.mobile_phone || customer.telephone || '').replace(/\\D/g, '');\nif (phone.length === 11) phone = '55' + phone;\nelse if (phone.length === 10) phone = '55' + phone;\n\n// Rastreio para pedidos enviados\nconst tracking = order.Delivery?.tracking_number\n  || order.OrderProduct?.[0]?.Product?.tracking_number\n  || '';\n\n// Mapeamento status → mensagem\nconst mensagens = {\n  2:  `Olá ${firstName}! 🎉 Seu pedido *#${orderId}* foi *aprovado* e já está sendo preparado. Em breve você receberá mais novidades!`,\n  4:  `Olá ${firstName}! Seu pedido *#${orderId}* foi *cancelado*. Caso tenha dúvidas, entre em contato com nossa equipe.`,\n  6:  `Olá ${firstName}! 📦 Seu pedido *#${orderId}* foi *despachado*!${tracking ? `\\nCódigo de rastreio: *${tracking}*\\nAcompanhe em: correios.com.br` : ''}`,\n  7:  `Olá ${firstName}! ✅ Seu pedido *#${orderId}* foi *entregue*! Esperamos que goste da compra. Qualquer dúvida, estamos aqui! 😊`\n};\n\nconst message = mensagens[status];\n\nreturn [{\n  json: {\n    skip: !message,\n    phone,\n    message: message || '',\n    status,\n    orderId,\n    customerName: customer.name || '',\n    reason: !message ? `status ${status} não mapeado` : null\n  }\n}];"
      },
