      "parameters": {
        "jsCode": "const inboxAlvo = $('Config Chatwoot').item.json.chatwoot_inbox_id;\nconst conversas = $json.payload || [];\n\nconst aberta = conversas.find(c => c.status === 'open' && c.inbox_id === inboxAlvo);\n\nreturn [{ json: { conversation_id: aberta ? aberta.id : null } }];"
