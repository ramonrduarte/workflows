    {
      "parameters": {
        "jsCode": "const b = $('Webhook Chatwoot').first().json.body || {};\nconst cfg = $('Config').first().json;\nconst inbox = Number(b.inbox?.id ?? b.conversation?.inbox_id);\nconst perguntas = Number(cfg.inbox_perguntas);\nconst mensagens = Number(cfg.inbox_mensagens);\n\nconst valido = b.event === 'message_created'\n  && (b.message_type === 'outgoing' || b.message_type === 1)\n  && b.private !== true\n  && String(b.content || '').trim() !== ''\n  && [perguntas, mensagens].includes(inbox);\n\nif (!valido) return [];\n\nreturn [{ json: {\n  conversation_id: b.conversation?.id,\n  inbox_id: inbox,\n  tipo: inbox === perguntas ? 'pergunta' : 'mensagem',\n  content: String(b.content).trim(),\n} }];\n"
      },
