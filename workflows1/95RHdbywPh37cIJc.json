    {
      "parameters": {
        "jsCode": "const b = $('Webhook Chatwoot').first().json.body || {};\nconst cfg = $('Config').first().json;\nconst inbox = Number(b.inbox?.id ?? b.conversation?.inbox_id);\nconst perguntas = Number(cfg.inbox_perguntas);\nconst mensagens = Number(cfg.inbox_mensagens);\n\nlet ca = b.content_attributes || {};\nif (typeof ca === 'string') { try { ca = JSON.parse(ca); } catch (e) { ca = {}; } }\n\nconst content = String(b.content || '').trim();\nconst anexos = (b.attachments || []).map(a => {\n  let url = a.data_url || a.file_url || '';\n  if (url && !/^https?:/i.test(url)) url = cfg.chatwoot_url + url;\n  let nome = 'anexo';\n  try { nome = decodeURIComponent(url.split('?')[0].split('/').pop()) || 'anexo'; } catch (e) {}\n  return { url, nome, tipo: a.file_type || '' };\n}).filter(a => a.url);\n\nconst valido = b.event === 'message_created'\n  && !ca.origem_ml  // veio do ML (espelhada pelo n8n): não reenviar\n  && !String(b.source_id || '').startsWith('ml_')\n  && !String(b.client_message_id || '').startsWith('ml_')\n  && (b.message_type === 'outgoing' || b.message_type === 1)\n  && b.private !== true\n  && (content !== '' || anexos.length > 0)\n  && [perguntas, mensagens].includes(inbox);\n\nif (!valido) return [];\n\nreturn [{ json: {\n  conversation_id: b.conversation?.id,\n  inbox_id: inbox,\n  tipo: inbox === perguntas ? 'pergunta' : 'mensagem',\n  content,\n  anexos,\n} }];\n"
      },
