    {
      "parameters": {
        "jsCode": "// Pega o texto do agente\nconst raw = $json.output ?? \"\";\n\n// Remove cercas de markdown ```json ... ```\nconst cleaned = raw\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  // Se falhar, retorna como texto simples pra você tratar depois\n  return [{\n    json: {\n      action: \"send_text\",\n      text: raw,\n      parseError: true\n    }\n  }];\n}\n\n// Se deu certo, devolve o JSON já “pronto”\nreturn [{ json: parsed }];"
      },
